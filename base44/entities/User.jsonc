{
  "name": "User",
  "type": "object",
  "properties": {
    "theme_preference": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "description": "Preferred app color theme"
    },
    "currency_preference": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "JPY",
        "CAD",
        "AUD",
        "CHF",
        "CNY",
        "INR",
        "BRL",
        "MXN",
        "SEK",
        "NOK",
        "DKK",
        "SGD"
      ],
      "description": "Preferred display currency"
    }
  }
}