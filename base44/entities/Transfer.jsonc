{
  "name": "Transfer",
  "type": "object",
  "properties": {
    "source_account_id": {
      "type": "string",
      "description": "ID of the bank account money moved from"
    },
    "source_account_name": {
      "type": "string",
      "description": "Source account name stored for display"
    },
    "destination_account_id": {
      "type": "string",
      "description": "ID of the bank account money moved to"
    },
    "destination_account_name": {
      "type": "string",
      "description": "Destination account name stored for display"
    },
    "amount": {
      "type": "number",
      "description": "Amount transferred"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "source_account_id",
    "source_account_name",
    "destination_account_id",
    "destination_account_name",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}